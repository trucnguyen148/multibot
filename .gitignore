# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# secrets. Create React App only ignores the .local variants by default, which
# leaves a bare .env committable. OPENROUTER_API_KEY lives in .env.local, so the
# wider pattern is deliberate.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# go build output and local sqlite database
/src/go/multibot
/src/go/sessions.db

# browser automation artifacts
.playwright-mcp/
